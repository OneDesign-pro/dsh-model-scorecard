{
  "name": "dsh-model-scorecard",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "A scorecard for every configured (provider, model) route: measured speed and stability folded from DSH session history, a 0-100 technical rating, the on-demand check of whether a route answers right now, and what the adapter declares about itself. Zero runtime dependencies.",
  "icon": "icon.svg",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-plugin-manager"
      ]
    }
  },
  "files": [
    "lib/",
    "tools/",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "locale/",
    "README.md",
    "README_ru.md",
    "docs/*.md",
    "COMPARISON.md",
    "package.json"
  ]
}
